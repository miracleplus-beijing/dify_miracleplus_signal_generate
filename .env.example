# ========================================
# Dify API 配置
# ========================================
DIFY_BASE_URL="https://api.dify.ai/v1"

# 奇绩信号Alpha Sight播客生成器 Workflow
DIFY_PODCAST_WORKFLOW_ID="https://udify.app/workflow/YOUR_PODCAST_WORKFLOW_ID"
DIFY_PODCAST_API_KEY="app-YOUR_PODCAST_API_KEY"

# Cheese Daily Workflow
DIFY_CHEESE_DAYLY_WORKFLOW_ID="https://udify.app/workflow/YOUR_CHEESE_DAILY_WORKFLOW_ID"
DIFY_CHEESE_DAYLY_API_KEY="app-YOUR_CHEESE_DAILY_API_KEY"

# ========================================
# 处理模式配置
# ========================================
# 批量处理模式: batch=批量数组 | sequential=串行单条
DIFY_BATCH_MODE="batch"

# Dify输入/输出变量名（需与Workflow配置一致）
DIFY_BATCH_INPUT_VARIABLE="arxiv_urls"      # 批量模式输入变量
DIFY_SINGLE_INPUT_VARIABLE="arxiv_url"      # 单条模式输入变量
DIFY_BATCH_OUTPUT_VARIABLE="results"        # 批量模式输出变量

# ========================================
# 单条模式重试配置
# ========================================
# 单条处理失败重试次数
SEQUENTIAL_RETRY_ATTEMPTS=3

# 单条处理重试间隔（毫秒）
SEQUENTIAL_RETRY_DELAY_MS=5000

# ========================================
# arXiv数据补全配置
# ========================================
# 是否启用arXiv数据补全（true/false）
ARXIV_ENRICH_ENABLED=true

# arXiv API调用间隔（毫秒，避免限流）
ARXIV_API_DELAY_MS=1000

# arXiv API最大重试次数
ARXIV_MAX_RETRIES=3

# arXiv API超时时间（毫秒）
ARXIV_TIMEOUT_MS=30000

# ========================================
# 音频生成配置（Python TTS）
# ========================================
# SiliconFlow API配置
SILICONFLOW_API_KEY="YOUR_SILICONFLOW_API_KEY"
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"

# Python解释器路径（可选，默认使用系统python）
PODCAST_PYTHON="python"

# 是否跳过音频生成（1=跳过，0=生成）
SKIP_TTS=0

# ========================================
# Supabase 数据库配置
# ========================================
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_API_KEY="YOUR_SERVICE_ROLE_KEY"

# ========================================
# 服务器配置
# ========================================
HOST="127.0.0.1"
PORT=8000

# ========================================
# 输出目录配置
# ========================================
# 自定义输出路径（可选，留空则使用默认 outputs/YYYY/MM/DD/）
CUSTOM_OUTPUT_DIR=""

# ========================================
# 日志配置
# ========================================
# 日志级别: debug | info | warning | error
LOG_LEVEL="info"

# 是否启用详细日志（true/false）
VERBOSE_LOGGING=false

# ========================================
# 使用说明
# ========================================
# 1. 复制此文件并重命名为 .env
# 2. 将 YOUR_* 占位符替换为你的实际配置
# 3. 从 Dify 控制台获取 Workflow ID 和 API Key
# 4. 保存后重启服务器
#
# 配置说明：
# - 批量模式(batch): 一次性处理所有数据，速度快但无重试
# - 单条模式(sequential): 逐条处理并实时上传，支持失败重试3次
# - 单条模式适合大批量数据或网络不稳定场景
